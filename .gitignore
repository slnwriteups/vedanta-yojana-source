# Next.js application scaffold — build/dependency artifacts only.
# This file intentionally does NOT exclude content-extraction/, images/,
# or any historical SAP export file; those remain fully tracked/visible.

# dependencies
/node_modules

# next.js build output
/.next/
/out/

# generated by scripts/build-search-index.ts on every build -- a pure
# derivative of content/, regenerated by `prebuild`, never hand-edited
/public/search-index.json

# generated by scripts/build-book-payloads.ts on every build -- the
# downloadable book payloads mobile/services/bookOfflineService.ts
# fetches; a pure derivative of content/library/, regenerated by
# `prebuild`, never hand-edited
/public/books/

# generated by scripts/build-content-manifest.ts on every build (after
# build-book-payloads.ts, whose output it hashes) -- the content-update
# catalog mobile/services/libraryCatalogService.ts polls to discover a
# new/changed book without a new APK; a pure derivative of
# content/library/ + public/books/, regenerated by `prebuild`, never
# hand-edited
/public/content-manifest.json

# production build
/build

# typescript
*.tsbuildinfo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
.vercel
.env*

# signing/credential material -- should never live in this repo; kept here
# for defense-in-depth even though no such files are tracked today
*.key
*.p12
*.jks
*.keystore
*.mobileprovision
google-services.json
GoogleService-Info.plist
credentials.json
