  "translations": {
    "ta": {
      "title": "ஆழ்வார் வைபவம்",
      "description": "ஸ்ரீமன் நாராயணனிடம் கொள்ளும் பக்தியைத் தமிழில் மக்களிடம் கொண்டு சேர்த்த அருளாளர்-கவிஞர்களான பன்னிரு ஆழ்வார்களின் வாழ்க்கை வரலாறு."
    },
    "kn": {
      "title": "ಆಳ್ವಾರ್ ವೈಭವಂ",
      "description": "ಶ್ರೀಮನ್ ನಾರಾಯಣನಲ್ಲಿನ ಭಕ್ತಿಯನ್ನು ತಮಿಳಿನಲ್ಲಿ ಜನಸಾಮಾನ್ಯರಿಗೆ ತಲುಪಿಸಿದ ಸಂತಕವಿಗಳಾದ ಹನ್ನೆರಡು ಆಳ್ವಾರರ ಜೀವನಚರಿತ್ರೆಗಳು."
    },
    "hi": {
      "title": "आळ्वार् वैभवम्",
      "description": "बारह आळ्वारों का जीवन, वे संत-कवि जिन्होंने तमिऴ् में श्रीमन्नारायण की भक्ति को जन-जन तक पहुँचाया।"
    },
    "te": {
      "title": "ఆళ్వార్ వైభవం",
      "description": "శ్రీమన్నారాయణుని పట్ల భక్తిని తమిళంలో ప్రజల వద్దకు చేర్చిన భక్త కవులైన పన్నెండు మంది ఆళ్వార్ల జీవిత చరిత్రలు."
    }
  }
