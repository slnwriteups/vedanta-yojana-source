    },
    "kn": {
      "title": "ದೇವಾಲಯಗಳು ಮತ್ತು ಉತ್ಸವಗಳು",
      "description": "ಕ್ಷೇತ್ರಗಳು ಮತ್ತು ಅಲ್ಲಿ ಆಚರಿಸಲಾಗುವ ಪವಿತ್ರ ಉತ್ಸವಗಳು."
    },
    "hi": {
      "title": "मंदिर और उत्सव",
