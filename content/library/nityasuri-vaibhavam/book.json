  "translations": {
    "ta": {
      "title": "நித்யசூரி வைபவம்",
      "description": "ஸ்ரீமன் நாராயணனின் நித்திய அடியார்களான நித்யசூரிகளின் மகிமை: அவருடைய வாகனமான கருடனும், அவருடைய திவ்விய சக்கரமான சுதர்சனமும்."
    },
    "kn": {
      "title": "ನಿತ್ಯಸೂರಿ ವೈಭವಂ",
      "description": "ಶ್ರೀಮನ್ ನಾರಾಯಣನ ಶಾಶ್ವತ ಸೇವಕರಾದ ನಿತ್ಯಸೂರಿಗಳ ಮಹಿಮೆಗಳು: ಅವನ ವಾಹನವಾದ ಗರುಡ ಮತ್ತು ಅವನ ದಿವ್ಯ ಚಕ್ರವಾದ ಸುದರ್ಶನ."
    },
    "hi": {
      "title": "नित्यसूरि वैभवम्",
      "description": "श्रीमन्नारायण के शाश्वत सेवक नित्यसूरियों की महिमा: उनके वाहनम् गरुड़, और उनके दिव्य चक्र सुदर्शन।"
    },
    "te": {
      "title": "నిత్యసూరి వైభవం",
      "description": "శ్రీమన్నారాయణుని శాశ్వత సేవకులైన నిత్యసూరుల వైభవం: ఆయన వాహనమైన గరుడుడు, ఆయన దివ్య చక్రమైన సుదర్శనుడు."
    }
  }
