  "translations": {
    "hi": {
      "title": "श्री विष्णु सहस्रनाम अनुभवम्",
      "description": "श्री पराशर भट्ट की टीका के अनुसार श्री विष्णु के हजार नामों की एक-एक करके व्याख्या: प्रत्येक श्लोक, प्रत्येक नाम IAST और देवनागरी में उसके मंत्रम् सहित, तथा फलश्रुति।"
    },
    "ta": {
      "title": "ஸ்ரீ விஷ்ணு ஸஹஸ்ரநாம அனுபவம்",
      "description": "ஸ்ரீ பராசர பட்டரின் வியாக்கியானத்தைப் பின்பற்றி, ஸ்ரீ விஷ்ணுவின் ஆயிரம் திருநாமங்களையும் ஒவ்வொன்றாக விளக்கும் நூல்: ஒவ்வொரு ஸ்லோகமும், IAST மற்றும் தேவநாகரி எழுத்துகளில் ஒவ்வொரு திருநாமமும் அதற்குரிய மந்திரமும், பலஶ்ருதியும் இதில் இடம்பெறுகின்றன."
    },
    "kn": {
      "title": "ಶ್ರೀ ವಿಷ್ಣು ಸಹಸ್ರನಾಮ ಅನುಭವಂ",
      "description": "ಶ್ರೀ ಪರಾಶರ ಭಟ್ಟರ ವ್ಯಾಖ್ಯಾನವನ್ನು ಅನುಸರಿಸಿ ಶ್ರೀ ವಿಷ್ಣುವಿನ ಸಾವಿರ ನಾಮಗಳನ್ನು ಒಂದೊಂದಾಗಿ ವಿವರಿಸುವ ಗ್ರಂಥ: ಪ್ರತಿಯೊಂದು ಶ್ಲೋಕ, ಪ್ರತಿಯೊಂದು ನಾಮವನ್ನು IAST ಮತ್ತು ದೇವನಾಗರಿ ಲಿಪಿಗಳಲ್ಲಿ ಅದರ ಮಂತ್ರದೊಂದಿಗೆ ಹಾಗೂ ಫಲಶ್ರುತಿಯನ್ನು ಒಳಗೊಂಡಿದೆ."
    },
    "te": {
      "title": "శ్రీ విష్ణు సహస్రనామ అనుభవం",
      "description": "శ్రీ పరాశర భట్టర్ వ్యాఖ్యానాన్ని అనుసరిస్తూ శ్రీ విష్ణువు యొక్క వెయ్యి నామాలను ఒక్కొక్కటిగా వివరించే గ్రంథం: ప్రతి శ్లోకం, ప్రతి నామం IAST మరియు దేవనాగరి లిపులలో దాని మంత్రంతో పాటు, ఫలశ్రుతి ఇందులో ఉన్నాయి."
    }
  }
}
